[Unit]
Description=Wildlife warning post (camera pipeline + LED sign)
After=network-online.target arduino-router.service
Wants=network-online.target

[Service]
User=arduino
Group=arduino
SupplementaryGroups=video arduino-router
WorkingDirectory=/home/arduino/yolo
ExecStart=/home/arduino/yolo-env/bin/python -u /home/arduino/yolo/wildwatch.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
